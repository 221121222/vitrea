<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>Vitrea</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<!-- 关键：不加进白名单，canOpenURL 恒 false 会误判未安装 -->
		<string>localdevvpn</string>
		<string>prefs</string>
		<string>app-prefs</string>
		<string>App-prefs</string>
		<string>App-Prefs</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- 随机卡面：小组件点击 → vitrea://card?d=… 打开对应卡面详情 -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>cc.cardart.workshop.randomcard</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>vitrea</string>
			</array>
		</dict>
	</array>
	<!-- RPPairing 本机配对广播 -->
	<key>NSBonjourServices</key>
	<array>
		<string>_remotepairing-pairable-host._tcp</string>
		<string>_aircardprobe._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Vitrea 需要广播本机配对服务，让这台 iPhone 与自身完成开发者配对，并连接本地 lockdown 服务写入卡面缓存。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Vitrea 需要读取相册图片，用于制作 Apple Wallet 卡面。</string>
	<!-- 写入卡面时把进度显示在灵动岛 / 锁屏（Live Activity） -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<!-- 配对期间在设置里输 PIN，需要音频保活 -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>cc.cardart.passthm</string>
			<key>UTTypeDescription</key>
			<string>Passcode Theme</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>passthm</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Passcode Theme</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>cc.cardart.passthm</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Pairing File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.apple.property-list</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
